# --- 서버 ---
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/attendance
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
# HTTPS 뒤에 두는 것이 기본입니다. HTTP 로만 접근하는 내부망이라면 false 로 두세요.
# 이걸 잘못 두면 로그인이 조용히 무한 반복됩니다 (쿠키가 전송되지 않아서).
COOKIE_SECURE=true

# --- 기본 매장 시간대/정책 (매장별로 DB에서 덮어씀) ---
DEFAULT_TIMEZONE=Asia/Seoul

# --- OCR (선택) ---
# 비워두면 근무표 가져오기 기능이 꺼집니다. 편집기만 쓰려면 비워두세요.
# 주의: 이미지가 해외로 전송됩니다. 국외이전 고지·동의가 필요합니다.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
